# === RIVINS Guardian — configuratie ===
# Kopieer dit bestand naar ".env" en vul in. Vul .env NOOIT publiek/in de webroot in
# (zie de RIVINS Ecosystem Notes, sectie "secrets-audit", voor waarom dat belangrijk is).
# In Pterodactyl vul je deze waarden in via "Startup Variables" in het paneel,
# niet als los bestand — dat voorkomt dat er ooit een .env in een verkeerde map belandt.

# Discord bot-token (Developer Portal > je applicatie > Bot > Token)
DISCORD_TOKEN=

# De guild (server) ID van RIVINSlive
GUILD_ID=1209644109485187112

# Jouw eigen Discord user-ID (Boxxy) — enige die de "owner override" krijgt
# (bijv. protection-modules tijdelijk uitzetten). Geen enkel ander account krijgt dit.
OWNER_ID=

# Kanaal-ID waar logs (message delete/edit, joins, bans, rolwijzigingen) naartoe gaan
LOG_CHANNEL_ID=

# Kanaal-ID specifiek voor admin-abuse-alerts (aanrader: apart, zeer beperkt zichtbaar kanaal)
ADMIN_ALERT_CHANNEL_ID=

# SQLite-databestand (lokaal, geen externe database-service nodig)
DB_PATH=./data/guardian.sqlite

# --- Dashboard (optioneel, los proces) ---
DASHBOARD_PORT=3001
SESSION_SECRET=
# OAuth2-gegevens van dezelfde Discord-applicatie (Developer Portal > OAuth2)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://guardian.rivinshosting.com/auth/callback
# Comma-gescheiden lijst van toegestane IP's of CIDR-ranges voor het dashboard,
# bv. "82.171.23.100,192.168.1.0/24". Dit is de EERSTE check, vóór Discord-login
# — een verkeerd IP ziet zelfs het loginscherm niet. Leeg laten = geen IP-check
# (dan beschermt alleen Discord-login nog).
DASHBOARD_IP_WHITELIST=
# Comma-gescheiden lijst van user-ID's die het dashboard mogen inloggen
DASHBOARD_ALLOWED_USER_IDS=
